        "df_bb.columns = ['Abertura', 'Máxima', 'Mínima', 'Fechamento', 'Volume']\n",
        "\n",
        "print(f\"Período: {df_bb.index.min().date()} até {df_bb.index.max().date()}\")\n",
        "\n",
